# PostgreSQL - Backend
DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5433/financeiq

# Airflow Metadata Database
AIRFLOW_DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5433/airflow

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=financeiq
DB_USER=your_user
DB_PASSWORD=your_password

# ETL Configuration
RELOAD_TRUNCATE=false

# AI Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT Authentication
FINANCEIQ_SECRET_KEY=replace_with_a_random_secret

# Optional local development accounts
FINANCEIQ_ADMIN_EMAIL=
FINANCEIQ_ADMIN_PASSWORD=
FINANCEIQ_DEMO_EMAIL=
FINANCEIQ_DEMO_PASSWORD=
FINANCEIQ_ALEX_EMAIL=
FINANCEIQ_ALEX_PASSWORD=
FINANCEIQ_JORDAN_EMAIL=
FINANCEIQ_JORDAN_PASSWORD=
